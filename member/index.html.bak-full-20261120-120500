   {t:'SL beyond spread',ok:true}];
 }else{
  a.reasons=[d.reason?esc(d.reason):'Tiada setup jelas sekarang.','Tiada entry dicadangkan — tunggu setup lebih jelas.'];
  a.checks=[{t:'Arah jelas (BUY/SELL) — masih menunggu',ok:false},
   {t:'Risk:Reward ≥ 1:1.5 — tiada setup',ok:false},
   {t:'Keyakinan AI ≥ 50%',ok:conf>=50},
   {t:'SL beyond spread — tiada entry',ok:false}];
 }
 a.risk=['Berita ekonomi boleh menggerakkan pasaran secara tiba-tiba.',
  'Jangan risiko lebih 1–2% akaun untuk satu trade.',
  hold?'Elak masuk tanpa pengesahan — sabar juga satu strategi.':'Jika harga tutup melepasi Stop Loss ('+f(a.sl)+'), idea ini batal.'];
 return a;
}

