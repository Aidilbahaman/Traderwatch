  [[a.entry,'#8ab4ff','E',1],[a.tp,'#b7f36b','TP',tt],[a.sl,'#ff777d','SL',tt]].forEach(function(l){
   var yy=y(l[3]===1?l[0]:a.entry+(l[0]-a.entry)*tt);cx.strokeStyle=l[1];cx.setLineDash([5,4]);cx.beginPath();cx.moveTo(ex,yy);cx.lineTo(xr,yy);cx.stroke();cx.setLineDash([]);
   cx.globalAlpha=Math.min(1,tt*1.4);pill(W-pR+2,yy,54,fx(p,l[0]),l[1],'#0a0e0b');cx.fillStyle=l[1];cx.font='800 10px ui-monospace,Menlo,monospace';cx.textAlign='left';cx.fillText(l[2],ex+8,yy+(l[2]==='SL'===(a.dir==='BUY')?10:-9));cx.globalAlpha=1});
