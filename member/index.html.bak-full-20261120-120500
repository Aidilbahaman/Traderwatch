<title>TraderWatch — AI Analyst</title>
<style>
:root{--bg:#0a0e0b;--card:#111612;--card2:#171e18;--text:#eef3ee;--muted:#8a978c;--line:#222b23;--lime:#b7f36b;--green:#b7f36b;--red:#ff777d;--orange:#ffc16b;--blue:#8ab4ff;color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg)}
body{font:15px/1.5 -apple-system,BlinkMacSystemFont,"Inter","Segoe UI",sans-serif;letter-spacing:-.02em;color:var(--text);min-height:100vh;background:radial-gradient(ellipse 80% 38% at 50% -12%,#b7f36b1c 0,transparent 62%),var(--bg);padding-bottom:calc(34px + env(safe-area-inset-bottom))}
body.lock{overflow:hidden}
button,input{font:inherit}button{cursor:pointer;border:0}
.wrap{max-width:560px;margin:auto;padding:0 16px}
header{position:sticky;top:0;z-index:10;background:#0a0e0bcc;backdrop-filter:saturate(160%) blur(18px);-webkit-backdrop-filter:saturate(160%) blur(18px);padding:calc(12px + env(safe-area-inset-top)) 16px 12px;border-bottom:1px solid var(--line)}
.hrow{max-width:560px;margin:auto;display:flex;align-items:center;gap:11px}
.logo{width:34px;height:34px;border-radius:11px;background:var(--lime);color:#10150b;display:grid;place-items:center;font-weight:950;font-size:17px;box-shadow:0 0 24px #b7f36b33}
.hrow b{font-size:15px;letter-spacing:.02em;font-weight:800}.hrow small{display:block;color:var(--muted);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.live{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:10px;font-weight:800;letter-spacing:.12em;color:var(--lime)}
.live i{width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 10px var(--lime);animation:pl 1.6s infinite}
@keyframes pl{50%{opacity:.3}}
h1{font-size:32px;line-height:1.08;letter-spacing:-.05em;margin:24px 0 6px;font-weight:850}h1 span{color:var(--lime)}
.sub{color:var(--muted);margin:0 0 16px}
.search{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:0 14px;margin-bottom:12px;transition:.2s}
.search:focus-within{border-color:var(--lime);box-shadow:0 0 0 3px #b7f36b18}
.search svg{flex:none;opacity:.55}
.search input{flex:1;background:transparent;border:0;outline:0;color:var(--text);padding:13px 0;font-size:15px}
.tabs{display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}
.tab{background:var(--card);border:1px solid var(--line);color:var(--muted);padding:8px 14px;border-radius:999px;font-weight:700;font-size:13px;white-space:nowrap;transition:.15s}
.tab.on{background:var(--lime);border-color:var(--lime);color:#10150b}
.pairs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.pair{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;text-align:left;transition:transform .15s,border-color .2s,box-shadow .2s;position:relative;overflow:hidden;color:var(--text);animation:up .45s both}
.pair:active{transform:scale(.96)}
.pair:hover{border-color:#34452f}
.pair::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at var(--mx,50%) var(--my,0%),#b7f36b14,transparent 55%);opacity:0;transition:.25s;pointer-events:none}
.pair:hover::after,.pair:active::after{opacity:1}
.pair .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px}
.ic{background:#1b2417;color:var(--lime);border:1px solid #2c3a25;display:grid;place-items:center;font-weight:800}
.pair .ic{width:32px;height:32px;border-radius:10px;font-size:10px}
.spark{width:62px;height:26px}
.pair .nm{font-weight:800;font-size:16px;letter-spacing:-.03em}
.pair .ds{font-size:11px;color:var(--muted);margin-top:1px}
.pair .px{font-weight:700;font-variant-numeric:tabular-nums;margin-top:9px;font-size:15px}
.pair .ch{font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}
.up{color:var(--green)}.dn{color:var(--red)}
.none{grid-column:1/-1;text-align:center;color:var(--muted);padding:30px 0}
.hint{display:flex;align-items:center;gap:8px;justify-content:center;color:#5d695f;font-size:12px;margin:18px 0 0}
.hint i{width:6px;height:6px;border-radius:50%;background:var(--lime);opacity:.7}
.foot{text-align:center;color:#5d695f;font-size:11px;margin:16px 0 0}
@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* ---- sheet ---- */
#bd{position:fixed;inset:0;background:#000b;opacity:0;pointer-events:none;transition:opacity .3s;z-index:40;backdrop-filter:blur(3px)}
#sheet{position:fixed;left:0;right:0;bottom:0;margin:auto;max-width:560px;max-height:94vh;overflow-y:auto;overscroll-behavior:contain;background:var(--card);border:1px solid var(--line);border-bottom:0;border-radius:28px 28px 0 0;z-index:41;transform:translateY(108%);transition:transform .42s cubic-bezier(.2,.9,.2,1);padding:0 16px calc(24px + env(safe-area-inset-bottom));box-shadow:0 -20px 60px #000c}
#sheet.drag{transition:none}
.open #bd{opacity:1;pointer-events:auto}.open #sheet{transform:none}
.grab{position:sticky;top:0;z-index:3;background:linear-gradient(var(--card) 70%,transparent);padding:10px 0 10px;touch-action:none}
.grab i{display:block;width:40px;height:5px;border-radius:9px;background:#2f3a30;margin:auto}
.shead{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.shead .ic{width:42px;height:42px;border-radius:13px;font-size:12px}
.shead h2{margin:0;font-size:20px;letter-spacing:-.04em;line-height:1.15}
.shead p{margin:0;color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}
.x{margin-left:auto;width:34px;height:34px;border-radius:50%;background:var(--card2);color:var(--muted);font-size:15px}
.chartbox{position:relative;border:1px solid var(--line);border-radius:18px;background:#0c110d;overflow:hidden}
#cv{display:block;width:100%;height:236px}
.chip{position:absolute;left:10px;top:10px;display:flex;align-items:center;gap:6px;background:#0a0e0bcc;border:1px solid var(--line);border-radius:999px;padding:4px 10px;font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted);backdrop-filter:blur(6px)}
.chip i{width:6px;height:6px;border-radius:50%;background:#5d695f}
.chip.scan{color:var(--lime);border-color:#b7f36b55}.chip.scan i{background:var(--lime);box-shadow:0 0 8px var(--lime);animation:pl .7s infinite}
.chip.done{color:var(--lime)}.chip.done i{background:var(--lime)}
.tf{display:flex;gap:4px;background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:3px;margin:12px 0}
.tf button{flex:1;background:transparent;color:var(--muted);padding:8px 0;border-radius:9px;font-weight:700;font-size:12px;transition:.15s}
.tf button.on{background:var(--lime);color:#10150b}
.go{position:relative;overflow:hidden;width:100%;padding:15px;border-radius:15px;font-weight:800;font-size:16px;color:#10150b;background:var(--lime);box-shadow:0 0 30px #b7f36b30;transition:transform .12s}
.go:active{transform:scale(.98)}
.go::after{content:"";position:absolute;top:0;bottom:0;width:60px;left:-80px;background:linear-gradient(100deg,transparent,#ffffff70,transparent);transform:skewX(-20deg);animation:shine 3.2s infinite}
@keyframes shine{to{left:120%}}
.hidden{display:none!important}
.term{margin-top:12px;background:#080b09;border:1px solid var(--line);border-radius:16px;padding:12px 14px;font:12.5px/1.75 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#9fb3a0;min-height:60px}
.term .tl{white-space:pre-wrap;word-break:break-word}.term .tl b{color:var(--lime);font-weight:600}
.term .tl.cur::after{content:"▍";color:var(--lime);animation:pl .7s infinite;margin-left:2px}
.term .ok{color:var(--lime)}
.bias{display:flex;align-items:center;gap:14px;padding:16px;border-radius:20px;margin:14px 0 10px;border:1px solid var(--line);animation:up .5s both}
.bias.buy{background:#b7f36b12;border-color:#b7f36b40}.bias.sell{background:#ff777d12;border-color:#ff777d40}.bias.wait{background:#ffc16b12;border-color:#ffc16b40}
.bias .lab{font-size:10px;color:var(--muted);font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.bias .val{font-size:30px;font-weight:900;letter-spacing:-.05em;line-height:1.1}
.bias.buy .val{color:var(--green)}.bias.sell .val{color:var(--red)}.bias.wait .val{color:var(--orange)}
.bias .asof{font-size:11px;color:var(--muted);margin-top:3px}
.ring{margin-left:auto;position:relative;width:78px;height:78px;flex:none}
.ring svg{width:78px;height:78px}
.rb{fill:none;stroke:#ffffff12;stroke-width:7}
.rf{fill:none;stroke:var(--rc,#b7f36b);stroke-width:7;stroke-linecap:round;stroke-dasharray:213.6;stroke-dashoffset:213.6;transition:stroke-dashoffset 1.2s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 0 5px var(--rc,#b7f36b))}
.ring .n{position:absolute;inset:0;display:grid;place-items:center;text-align:center;font-weight:850;font-size:19px;line-height:1}
.ring .n small{display:block;font-size:8px;color:var(--muted);letter-spacing:.1em;font-weight:700;margin-top:3px}
.lv{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:6px}
.lv div{background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:11px 6px;text-align:center;animation:up .5s both}
.lv small{display:block;color:var(--muted);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.lv b{font-variant-numeric:tabular-nums;font-size:15px}
.lv .e b{color:var(--blue)}.lv .t b{color:var(--green)}.lv .s b{color:var(--red)}
.rr{font-size:12px;color:var(--muted);text-align:center;margin:8px 0 4px}
.sec{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin:18px 0 8px}
.chk{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.chk li{display:flex;align-items:center;gap:10px;background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:9px 12px;font-size:13.5px;animation:up .45s both}
.chk .b{flex:none;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:900}
.chk .y .b{background:#b7f36b22;color:var(--lime)}.chk .n .b{background:#ff777d1f;color:var(--red)}
.chk .n{color:var(--muted)}
.reasons{margin:0;padding:0;list-style:none}
.reasons li{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px;color:#d6ded6;animation:up .45s both}
.reasons li:last-child{border:0}
.dot{flex:none;width:8px;height:8px;border-radius:50%;margin-top:7px}
.ask{display:flex;gap:8px;flex-wrap:wrap}
.ask button{background:var(--card2);border:1px solid var(--line);color:var(--text);padding:9px 13px;border-radius:999px;font-size:13px;font-weight:600;transition:.15s}
.ask button:active,.ask button.on{background:var(--lime);border-color:var(--lime);color:#10150b}
.bub{margin-top:10px;background:#0c110d;border:1px solid var(--line);border-radius:16px 16px 16px 4px;padding:12px 14px;font-size:14px;color:#d6ded6}
.bub .who{display:flex;align-items:center;gap:6px;color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.1em;margin-bottom:4px}
.bub .who i{width:6px;height:6px;border-radius:50%;background:var(--lime)}
.bub.t .tx::after{content:"▍";color:var(--lime);animation:pl .7s infinite;margin-left:2px}
.note{font-size:12px;color:var(--muted);background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:11px 13px;margin-top:16px}
.soon{display:inline-block;background:#ffc16b1f;color:var(--orange);font-weight:800;font-size:9px;letter-spacing:.06em;padding:2px 7px;border-radius:7px;margin-left:6px;vertical-align:middle;text-transform:uppercase}
.cerr{position:absolute;inset:0;display:grid;place-items:center;background:#0c110dee;text-align:center;padding:18px;z-index:2}
.cerr p{margin:0 0 12px;color:var(--muted);font-size:13px}
.cerr button{background:var(--card2);border:1px solid var(--line);color:var(--text);padding:9px 16px;border-radius:12px;font-weight:700;font-size:13px}
.tfnote{margin:-4px 0 12px;text-align:center;color:#5d695f;font-size:11px}
.go:disabled{opacity:.55;box-shadow:none}
.go:disabled::after{animation:none}
.errbox{background:#ff777d12;border:1px solid #ff777d40;border-radius:16px;padding:14px;margin-top:14px;animation:up .45s both}
.errbox p{margin:0;font-size:13.5px;color:#d6ded6}
.soonbox{background:var(--card2);border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:4px;animation:up .45s both}
.soonbox .soonT{font-weight:800;font-size:15px;color:var(--orange);margin-bottom:6px}
.soonbox p{margin:0 0 12px;font-size:13.5px;color:#d6ded6}
.again{width:100%;margin-top:12px;padding:13px;border-radius:14px;background:var(--card2);border:1px solid var(--line);color:var(--text);font-weight:700}
#inst{position:fixed;left:14px;right:14px;bottom:calc(14px + env(safe-area-inset-bottom));z-index:60;display:none;align-items:center;gap:12px;padding:14px 16px;background:#111612f2;backdrop-filter:blur(18px);border:1px solid var(--line);border-radius:18px;box-shadow:0 16px 44px #000a;max-width:520px;margin:auto}
#inst.show{display:flex}#inst b{display:block;font-size:14px}#inst span{font-size:12px;color:var(--muted)}
#inst button{border-radius:12px;padding:10px 14px;font-weight:800;background:var(--lime);color:#10150b}#inst .xx{background:transparent;color:var(--muted);padding:8px}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<header><div class="hrow"><div class="logo">T</div><div><b>TRADERWATCH</b><small>AI Analyst</small></div><div class="live"><i></i>LIVE</div></div></header>
<div class="wrap">
  <h1>Signals,<br><span>annotated.</span></h1>
  <p class="sub">Pilih pair — AI baca chart dan lukis Entry, SL &amp; TP untuk anda.</p>
  <label class="search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b7f36b" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input id="q" type="search" aria-label="Cari pair" autocomplete="off"></label>
  <div class="tabs" id="tabs"></div>
  <div class="pairs" id="pairs"></div>
  <div class="hint"><i></i>Pilih pair untuk analisis AI masa sebenar.</div>
  <p class="foot">Educational only. Trading involves substantial risk.</p>
</div>

<div id="bd"></div>
<div id="sheet" role="dialog" aria-modal="true" aria-label="Analisis AI">
  <div class="grab" id="grab"><i></i></div>
  <div class="shead"><div class="ic" id="sIc"></div><div><h2 id="sNm"></h2><p id="sDs"></p></div><button class="x" id="sx" aria-label="Tutup">✕</button></div>
  <div class="chartbox" id="chartbox"><canvas id="cv"></canvas><div class="chip" id="chip"><i></i><span id="chipT">SEDIA</span></div><div class="cerr hidden" id="chartErr"><div><p>Gagal memuatkan chart. Periksa sambungan.</p><button id="chartRetry">Cuba lagi</button></div></div></div>
  <div class="tf" id="tf"></div>
  <p class="tfnote" id="tfnote">Analisis AI berasaskan struktur M15.</p>
  <button class="go" id="go">✦ Analisis dengan AI</button>
  <div class="term hidden" id="term"></div>
  <div id="res" class="hidden"></div>
</div>

<div id="inst"><div style="flex:1"><b>Pasang TraderWatch AI</b><span id="instTxt">Tambah ke home screen untuk akses pantas.</span></div><button id="instBtn">Pasang</button><button class="xx" id="instX" aria-label="Tutup">✕</button></div>

<script>
(function(){
'use strict';
/* Analisis AI sebenar: POST /api/analyze + GET /api/bars (Bearer token ahli).
   Respons verdict: {side,entry,sl,tp1,tp2,conf,reason,rr1,rr2,price,...} */
var AI_ENDPOINT='/api/analyze';
var AUTH_KEY='sb-vicfiftvhxemuhxxmkxk-auth-token';
var LOGIN_URL='https://traderwatch.org/login.html?next=%2Fmember%2F';
function getSession(){try{return JSON.parse(localStorage.getItem(AUTH_KEY)||'null')}catch(e){return null}}
function getToken(){var s=getSession();return s&&s.access_token?s.access_token:null}
/* Gate ahli: tiada session sah -> terus ke login, app tidak render. */
var sess=getSession();
if(!sess||!sess.access_token||(sess.expires_at&&sess.expires_at*1000<Date.now())){location.replace(LOGIN_URL);return}
function apiFetch(url,opts){
 opts=opts||{};
 opts.headers=Object.assign({Authorization:'Bearer '+getToken()},opts.headers||{});
 return fetch(url,opts).then(function(r){
  if(r.status===401){location.replace(LOGIN_URL);throw new Error('Sesi tamat')}
  return r.json().catch(function(){return{}}).then(function(j){return{ok:r.ok,status:r.status,data:j}});
 });
}
var esc=function(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
var $=function(i){return document.getElementById(i)};
var hap=function(m){try{navigator.vibrate&&navigator.vibrate(m)}catch(e){}};
var sleep=function(ms){return new Promise(function(r){setTimeout(r,ms)})};

var PAIRS=[
 {s:'XAUUSD',n:'Gold',g:'c',p:2650.40,d:2},{s:'EURUSD',n:'Euro / US Dollar',g:'f',p:1.0542,d:4},
 {s:'GBPUSD',n:'Pound / US Dollar',g:'f',p:1.2618,d:4},{s:'USDJPY',n:'US Dollar / Yen',g:'f',p:154.82,d:2},
 {s:'GBPJPY',n:'Pound / Yen',g:'f',p:195.34,d:2,soon:1},{s:'AUDUSD',n:'Aussie / US Dollar',g:'f',p:0.6521,d:4},
 {s:'USDCAD',n:'US Dollar / CAD',g:'f',p:1.3987,d:4},{s:'BTCUSD',n:'Bitcoin',g:'k',p:91250,d:0},
 {s:'ETHUSD',n:'Ethereum',g:'k',p:3120.5,d:1,soon:1},{s:'US30',n:'Dow Jones',g:'i',p:43850,d:0,soon:1}
];
var GROUPS=[['a','Semua'],['c','Komoditi'],['f','Forex'],['k','Crypto'],['i','Indeks']];
var TFS=['M5','M15','H1','H4','D1'];
var grp='a',cur=null,tf='H1';
var S={open:false,run:0,candles:[],m:null,ana:null,t:0,t0:0,scan:null,rv:1,rv0:0,busy:false};

/* ---------- seeded random ---------- */
function hash(s){var h=2166136261;for(var i=0;i<s.length;i++){h=Math.imul(h^s.charCodeAt(i),16777619)}return h>>>0}
function rng(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}

PAIRS.forEach(function(p){var r=rng(hash('h'+p.s));p.o=p.p;p.chg=(r()-.5)*1.4;p.h=[];var v=1;for(var i=0;i<28;i++){v+=(r()-.5)*.06+(p.chg>0?.004:-.004);p.h.push(v)}});
function fx(p,v){return Number(v).toFixed(p.d)}

/* ---------- pair list ---------- */
function spark(p){
 var h=p.h,mn=Math.min.apply(0,h),mx=Math.max.apply(0,h),w=62,ht=26,rg=mx-mn||1;
 var pts=h.map(function(v,i){return (i/(h.length-1)*w).toFixed(1)+','+(ht-2-(v-mn)/rg*(ht-4)).toFixed(1)}).join(' ');
 var c=h[h.length-1]>=h[0]?'#b7f36b':'#ff777d';
 return '<svg class="spark" viewBox="0 0 62 26"><polyline points="'+pts+'" fill="none" stroke="'+c+'" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
}
function drawTabs(){
 $('tabs').innerHTML=GROUPS.map(function(g){return '<button class="tab'+(g[0]===grp?' on':'')+'" data-g="'+g[0]+'">'+g[1]+'</button>'}).join('');
 Array.prototype.forEach.call($('tabs').querySelectorAll('.tab'),function(b){b.onclick=function(){grp=b.dataset.g;hap(8);drawTabs();drawPairs(false)}});
}
function drawPairs(quiet){
 var q=$('q').value.trim().toLowerCase();
 var list=PAIRS.filter(function(p){return (grp==='a'||p.g===grp)&&(!q||p.s.toLowerCase().indexOf(q)>-1||p.n.toLowerCase().indexOf(q)>-1)});
 $('pairs').innerHTML=list.length?list.map(function(p,i){
