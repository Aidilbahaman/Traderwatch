function ema(a,k){var m=2/(k+1),e=a[0];for(var i=1;i<a.length;i++)e=a[i]*m+e*(1-m);return e}
function rsi(a,k){k=k||14;var g=0,l=0;for(var i=a.length-k;i<a.length;i++){var d=a[i]-a[i-1];if(d>=0)g+=d;else l-=d}return l===0?100:100-100/(1+g/l)}
function metrics(c){
 var cl=c.map(function(x){return x.c}),n=c.length,sl=c.slice(-14),atr=sl.reduce(function(s,x){return s+x.h-x.l},0)/sl.length;
 var l40=c.slice(-40),hh=Math.max.apply(0,c.slice(-20).map(function(x){return x.h}))>Math.max.apply(0,c.slice(-40,-20).map(function(x){return x.h}));
 var ll=Math.min.apply(0,c.slice(-20).map(function(x){return x.l}))<Math.min.apply(0,c.slice(-40,-20).map(function(x){return x.l}));
 return {e20:ema(cl,20),e50:ema(cl,50),rsi:rsi(cl),atr:atr,sup:Math.min.apply(0,l40.map(function(x){return x.l})),res:Math.max.apply(0,l40.map(function(x){return x.h})),last:cl[n-1],hh:hh,ll:ll,n:n};
}
