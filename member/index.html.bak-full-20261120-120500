function mapVerdict(d,f){
 var hold=d.side==='HOLD',dir=hold?'WAIT':d.side,conf=Math.round((+d.conf||0)*100);
 var a={dir:dir,conf:conf,entry:null,sl:null,tp:null,tp2:null,reasons:[],risk:[],checks:[],asof:d.generated_at?new Date(d.generated_at):new Date()};
 if(!hold){
  a.entry=+d.entry;a.sl=+d.sl;a.tp=+d.tp1;a.tp2=d.tp2!=null?+d.tp2:null;
  a.reasons=[d.reason?esc(d.reason):null,
   'Entry pada harga semasa '+f(d.price)+'.',
   'Stop Loss '+f(d.sl)+' (risiko '+f(Math.abs(d.entry-d.sl))+' mata).',
   'TP1 '+f(d.tp1)+' · RR 1:'+d.rr1+'.',
   a.tp2!=null?'TP2 '+f(d.tp2)+' · RR 1:'+d.rr2+'.':null].filter(Boolean);
  a.checks=[{t:'Arah jelas (BUY/SELL)',ok:true},
