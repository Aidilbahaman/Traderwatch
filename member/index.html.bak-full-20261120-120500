  var yE=y(a.entry),yT=y(a.entry+(a.tp-a.entry)*tt),yS=y(a.entry+(a.sl-a.entry)*tt);
  cx.fillStyle='rgba(183,243,107,.13)';cx.fillRect(ex,Math.min(yE,yT),xr-ex,Math.abs(yT-yE));
